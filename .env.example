# Archivo de ejemplo de variables de entorno para Mi Coche por Dentro
# Conforme a la Sección 37 de especificación_maestra_del_proyecto.md

APP_ENV=development
DATABASE_PATH=./data/vehicle_ai.db
TELEMETRY_PATH=./data/telemetry
REPORT_PATH=./data/reports
LOG_LEVEL=INFO

# Configuración del Adaptador OBD
OBD_COM_PORT=COM4
OBD_BAUDRATE=115200

# Proveedor de Inteligencia Artificial (disabled / openai / anthropic / local)
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_API_KEY=

# Seguridad y Privacidad
SEND_VIN_TO_AI=false
# La aplicación mantiene el motor local como predeterminado incluso con clave.
# Cada consulta remota requiere activación explícita en la interfaz.
